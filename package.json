{
  "name": "canvas-atlas",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "An open-topic visual tutor with local lessons and official ChatGPT authorization",
  "main": "apps/desktop/out/main/app.js",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "electron-vite dev --config apps/desktop/electron.vite.config.ts",
    "dev:web": "vite --config apps/desktop/vite.web.config.ts --host 127.0.0.1",
    "build": "electron-vite build --config apps/desktop/electron.vite.config.ts && node --check apps/desktop/out/main/app.js",
    "preview": "electron-vite preview --config apps/desktop/electron.vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "eval:live": "node scripts/eval-live.mjs",
    "graphify": "pwsh -NoProfile -File scripts/graphify.ps1"
  },
  "build": {
    "appId": "org.livingcanvas.desktop",
    "productName": "Canvas Atlas",
    "asar": true,
    "asarUnpack": [
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-win-x64/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/desktop/out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*",
          "!**/*.bin",
          "!**/*.gguf"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Canvas Atlas",
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false
    }
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "jose": "6.2.13",
    "jsxgraph": "1.14.2",
    "katex": "0.19.0",
    "konva": "10.9.0",
    "lucide-react": "1.61.0",
    "matter-js": "0.20.0",
    "motion": "14.9.0",
    "pdfjs-dist": "6.4.299",
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "roughjs": "4.6.6",
    "sherpa-onnx-node": "1.13.8",
    "sherpa-onnx-win-x64": "1.13.8",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/katex": "0.16.8",
    "@types/matter-js": "0.20.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
